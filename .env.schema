# Local domain used by Docker Compose and Traefik
DOMAIN=example.arpa

# Worktree setup overrides these non-secret values in .env.worktree.local.
COMPOSE_PROJECT_NAME=project

# @type=port
APP_PORT=3000

# @type=port
TRAEFIK_PORT=8080

# @type=port
POSTGRES_PORT=5432
